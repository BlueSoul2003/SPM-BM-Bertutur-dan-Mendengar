# Local development uses embedded PostgreSQL under DATA_DIR/postgres.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# DATA_DIR=/private/spm-bm
# Production requires managed PostgreSQL with TLS configured by its provider.
DATABASE_URL=
# Set true ONLY for a single-process local production-build preview.
ALLOW_LOCAL_DATABASE=false
IMPORT_LEGACY_JSON=false

# Keep true for student-facing deployments. Gemini Developer API is disabled.
# false is only for an eligible adult-only development / teacher deployment.
STUDENT_DIRECT_MODE=true
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest
FREE_AI_DAILY_LIMIT=10
PREMIUM_AI_DAILY_LIMIT=100

# Optional supported Cloud TTS; blank uses the existing device-voice fallback.
TTS_PROVIDER=
# Use workload identity / Application Default Credentials on the host.
# GOOGLE_APPLICATION_CREDENTIALS=/private/service-account.json
GOOGLE_TTS_VOICE=

# Password reset stays unavailable until SMTP and public APP_URL are configured.
SMTP_URL=
MAIL_FROM=

# Optional Stripe subscription; configure a recurring Price and customer portal.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
